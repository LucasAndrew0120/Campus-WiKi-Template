{
  "name": "campus-wiki-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "build:template": "npm run build --prefix template/wiki",
    "preview": "vitepress preview docs",
    "check": "npm run build && npm run build:template"
  },
  "devDependencies": {
    "vitepress-qutwiki-kit": "file:packages/vitepress-qutwiki-kit",
    "vitepress": "^1.5.0",
    "vue": "^3.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.63.1"
  }
}
